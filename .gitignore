# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDEs
/.idea

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Single lockfile: this project uses yarn.lock
package-lock.json

# A nested content/ inside a content section is never real content. It appears
# when a command using a repo-root-relative path (content/posts/...) is run
# from inside content/posts instead of the repo root.
/content/*/content/
